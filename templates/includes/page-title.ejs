<% if (pageData.title) { %>
    <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl lg:text-3xl">
            <%- pageData.title %>
        </h1>

        <div class="flex items-center gap-4">
            <!-- 字体大小控制按钮 -->
            <%- include('./page-font') %>

            <!-- 分享按钮 -->
            <%- include('./page-share') %>

            <!-- 编辑源码 -->
            <%- include('./page-edit') %>

            <!-- 查看源码 -->
            <%- include('./page-source') %>
        </div>
    </div>
    <% if (pageData.description) { %>
        <p class="mt-6 text-sm sm:text-base leading-6 text-gray-500 dark:text-gray-400 border-l-4 border-gray-200 dark:border-gray-700 pl-4 py-1 italic">
            <%- pageData.description %>
        </p>
    <% } %>

    <!-- 标签展示区域 -->
    <% if (pageData.tags && pageData.tags.length > 0) { %>
        <div class="flex flex-wrap gap-2 mt-4">
            <%
                const colorClasses = [
                    "bg-blue-100 text-blue-800 dark:bg-blue-700 dark:text-blue-100",
                    "bg-green-100 text-green-800 dark:bg-green-700 dark:text-green-100",
                    "bg-red-100 text-red-800 dark:bg-red-700 dark:text-red-100",
                    "bg-yellow-100 text-yellow-800 dark:bg-yellow-700 dark:text-yellow-100",
                    "bg-purple-100 text-purple-800 dark:bg-purple-700 dark:text-purple-100",
                    "bg-pink-100 text-pink-800 dark:bg-pink-700 dark:text-pink-100",
                    "bg-indigo-100 text-indigo-800 dark:bg-indigo-700 dark:text-indigo-100",
                    "bg-teal-100 text-teal-800 dark:bg-teal-700 dark:text-teal-100"
                ];

            pageData.tags.forEach(function(tag, index) {
                // 使用模运算选择颜色，确保颜色循环使用
                const colorClass = colorClasses[index % colorClasses.length];
            %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium <%= colorClass %>">
                <%= tag %>
            </span>
            <% }); %>
        </div>
    <% } %>
<% } %>