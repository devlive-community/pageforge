<div class="mt-4 pt-4 border-t border-dashed border-gray-200 dark:border-gray-700 not-prose">
    <!-- 时间和提交信息 -->
    <div class="space-x-6 text-sm text-gray-500 dark:text-gray-400 grid grid-cols-2 md:grid-cols-4 mb-4 gap-y-3 md:gap-y-0">
        <!-- 首次提交时间 -->
        <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="w-4 h-4">
                <circle cx="12" cy="12" r="3"/>
                <line x1="3" y1="12" y2="12" x2="9"/>
                <line x1="15" y1="12" y2="12" x2="21"/>
            </svg>
            <span>提交于 <%= new Date(pageData.gitInfo.revision.createTime).toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }) %></span>
        </div>

        <!-- 最后修改时间 -->
        <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="w-4 h-4">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
                <path d="M12 7v5l4 2"/>
            </svg>
            <span>修改于 <%= new Date(pageData.gitInfo.revision.lastModifiedTime).toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }) %></span>
        </div>

        <!-- Hash 链接 -->
        <% if (locals.siteData?.repo?.url) { %>
            <!-- 首次提交 -->
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                <a href="<%= `${locals.siteData.repo.url}/commit/${pageData.gitInfo.revision.commitHash}` %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="hover:text-blue-600 dark:hover:text-blue-400">
                    首次提交 (<%= pageData.gitInfo.revision.commitHash.slice(0, 8) %>)
                </a>
            </div>

            <!-- 末次提交 -->
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                <a href="<%= `${locals.siteData.repo.url}/commit/${pageData.gitInfo.revision.lastCommitHash}` %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="hover:text-blue-600 dark:hover:text-blue-400">
                    末次提交 (<%= pageData.gitInfo.revision.lastCommitHash.slice(0, 8) %>)
                </a>
            </div>
        <% } %>
    </div>
</div>