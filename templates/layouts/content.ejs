<!-- 页面容器 -->
<div class="relative lg:flex lg:gap-8">
    <!-- 主要内容区域 -->
    <div class="min-w-0 flex-1">
        <!-- 页面标题部分 -->
        <div class="mb-3">
            <% if (pageData.title) { %>
                <div class="flex items-center justify-between">
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl lg:text-3xl">
                        <%- pageData.title %>
                    </h1>

                    <div class="flex items-center gap-4">
                        <!-- 编辑源码 -->
                        <% if (locals.siteData.feature?.edit?.enable) { %>
                            <a href="<%= `${locals.siteData?.repo?.url}/edit/${locals.siteData?.repo?.branch || 'main'}/docs/content/${pageData.relativePath}` %>"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="ml-4 text-gray-400 hover:text-blue-700 dark:text-gray-400 dark:hover:text-gray-300 w-5 h-5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-edit w-5 h-5">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </a>
                        <% } %>

                        <!-- 查看源码 -->
                        <% if (locals.siteData.feature?.view?.enable) { %>
                            <a href="<%= `${locals.siteData?.repo?.url}/blob/${locals.siteData?.repo?.branch || 'main'}/docs/content/${pageData.relativePath}` %>"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="text-gray-400 hover:text-blue-700 dark:text-gray-400 dark:hover:text-gray-300 w-5 h-5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code w-5 h-5">
                                    <polyline points="16 18 22 12 16 6"/>
                                    <polyline points="8 6 2 12 8 18"/>
                                </svg>
                            </a>
                        <% } %>
                    </div>
                </div>
                <% if (pageData.description) { %>
                    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
                        <%- pageData.description %>
                    </p>
                <% } %>
            <% } %>
        </div>

        <!-- 分隔线 -->
        <div class="h-px bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 dark:from-gray-700 dark:via-gray-600 dark:to-gray-700 mb-8"></div>

        <!-- 主要内容部分 -->
        <div class="prose prose-gray dark:prose-invert max-w-none">
            <%- pageData.content %>
        </div>

        <!-- Git 信息部分 -->
        <% if (locals.siteData.feature?.revision?.enable && pageData.gitInfo) { %>
            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                <!-- 时间和提交信息 -->
                <div class="space-x-6 text-sm text-gray-500 dark:text-gray-400 grid grid-cols-4 mb-4">
                    <!-- 首次提交时间 -->
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="w-4 h-4">
                            <circle cx="12" cy="12" r="3"/>
                            <line x1="3" y1="12" y2="12" x2="9"/>
                            <line x1="15" y1="12" y2="12" x2="21"/>
                        </svg>
                        <span>提交于 <%= new Date(pageData.gitInfo.createTime).toLocaleDateString('zh-CN', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %></span>
                    </div>

                    <!-- 最后修改时间 -->
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="w-4 h-4">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                            <path d="M3 3v5h5"/>
                            <path d="M12 7v5l4 2"/>
                        </svg>
                        <span>修改于 <%= new Date(pageData.gitInfo.lastModifiedTime).toLocaleDateString('zh-CN', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %></span>
                    </div>

                    <!-- Hash 链接 -->
                    <% if (locals.siteData?.repo?.url) { %>
                        <!-- 首次提交 -->
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="w-4 h-4">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                            </svg>
                            <a href="<%= `${locals.siteData.repo.url}/commit/${pageData.gitInfo.commitHash}` %>"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="hover:text-blue-600 dark:hover:text-blue-400">
                                首次提交 (<%= pageData.gitInfo.commitHash.slice(0, 8) %>)
                            </a>
                        </div>

                        <!-- 末次提交 -->
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="w-4 h-4">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                            </svg>
                            <a href="<%= `${locals.siteData.repo.url}/commit/${pageData.gitInfo.lastCommitHash}` %>"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="hover:text-blue-600 dark:hover:text-blue-400">
                                末次提交 (<%= pageData.gitInfo.lastCommitHash.slice(0, 8) %>)
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- 贡献者信息 -->
                <% if (locals.siteData.feature?.contributors?.enable && pageData.gitInfo?.contributionStats) { %>
                    <div class="mt-4 pt-4 border-t border-dashed border-gray-200 dark:border-gray-700">
                        <div class="flex items-center gap-2 mb-3 text-sm text-gray-600 dark:text-gray-300">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 class="w-4 h-4">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            <span>贡献者</span>
                        </div>
                        <div class="flex flex-wrap gap-4">
                            <% pageData.gitInfo.contributionStats.forEach(function(contributor) { %>
                                <a href="<%= `https://github.com/${contributor.author}` %>"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="flex items-center gap-2 group">
                                    <img src="<%= `https://github.com/${contributor.author}.png?size=40` %>"
                                         alt="<%= contributor.author %>"
                                         class="w-8 h-8 rounded-full"
                                         loading="lazy">
                                    <div class="text-sm">
                                        <div class="text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                                            <%= contributor.author %>
                                        </div>
                                        <div class="text-gray-500 dark:text-gray-400">
                                            <%= contributor.commitCount %> 次提交
                                        </div>
                                    </div>
                                </a>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>