<!-- 页面容器 -->
<div class="relative lg:flex lg:gap-8">
    <!-- 主要内容区域 -->
    <div class="min-w-0 flex-1">
        <!-- 页面标题部分 -->
        <div class="mb-8">
            <%- include('../includes/page-title') %>
        </div>

        <!-- 主要内容部分 -->
        <div class="prose prose-gray dark:prose-invert max-w-none text-base">
            <%- pageData.content %>
        </div>

        <div class="clear-both"></div>

        <!-- Git 信息部分 -->
        <% if (locals.siteData.feature?.revision?.enable && pageData.gitInfo?.revision) { %>
            <%- include('../includes/git-revision') %>
        <% } %>

        <!-- 贡献者信息 -->
        <% if (locals.siteData.feature?.contributors?.enable && pageData.gitInfo?.contributors) { %>
            <%- include('../includes/git-contributors') %>
        <% } %>
    </div>
</div>